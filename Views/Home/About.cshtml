@{
    ViewData["Title"] = "About";
}

<section class="page-banner">
    <div class="container">
        <span class="eyebrow">ABOUT THE PROTOTYPE</span>
        <h1>Technology supporting humanitarian action.</h1>
        <p>This ASP.NET Core prototype demonstrates how a future humanitarian platform could connect donors, volunteers and employees.</p>
    </div>
</section>

<section class="section">
    <div class="container two-col">
        <div class="card">
            <h2>Prototype Features</h2>
            <ul class="feature-list">
                <li>ASP.NET Core MVC</li>
                <li>ASP.NET Core Identity authentication</li>
                <li>Employee and Donor roles</li>
                <li>SQLite data persistence</li>
                <li>Donation and volunteer workflows</li>
                <li>Responsive Bootstrap-inspired CSS</li>
            </ul>
        </div>
        <div class="card">
            <h2>Academic Scope</h2>
            <p>This Part 1 prototype uses a mock payment process. No real card or banking information is collected.</p>
            <p>The application is structured so that production payment services and expanded database functionality can be added in a later phase.</p>
        </div>
    </div>
</section>
