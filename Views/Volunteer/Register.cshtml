@model VolunteerViewModel
@{
    ViewData["Title"] = "Volunteer";
}

<section class="page-banner">
    <div class="container">
        <span class="eyebrow">JOIN THE RESPONSE</span>
        <h1>Volunteer Your Skills</h1>
        <p>Register your details so the relief team can identify suitable volunteer support.</p>
    </div>
</section>

<section class="section">
    <div class="container form-container">
        @if (TempData["Success"] != null)
        {
            <div class="success-box">@TempData["Success"]</div>
        }

        <form asp-action="Register" method="post" class="form-card">
            <div asp-validation-summary="ModelOnly" class="validation"></div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="FullName"></label>
                    <input asp-for="FullName" placeholder="e.g. Thabo Mokoena" />
                    <span asp-validation-for="FullName"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" placeholder="you@example.com" />
                    <span asp-validation-for="Email"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Skills"></label>
                <input asp-for="Skills" placeholder="First aid, driving, logistics, IT..." />
                <span asp-validation-for="Skills"></span>
            </div>

            <div class="form-group">
                <label asp-for="Availability"></label>
                <select asp-for="Availability">
                    <option value="">Select availability</option>
                    <option>Weekdays</option>
                    <option>Weekends</option>
                    <option>Evenings</option>
                    <option>Flexible</option>
                </select>
                <span asp-validation-for="Availability"></span>
            </div>

            <button class="btn btn-primary full-width" type="submit">Submit Volunteer Application</button>
        </form>
    </div>
</section>
